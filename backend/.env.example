
PORT=5000

MONGO_URI=mongodb+srv://YOUR_USERNAME:YOUR_PASSWORD@YOUR_CLUSTER/gradtrack?retryWrites=true&w=majority

# Use the same Atlas credentials/cluster with the separate test database.
TEST_MONGO_URI=mongodb+srv://YOUR_USERNAME:YOUR_PASSWORD@YOUR_CLUSTER/gradtrack_test?retryWrites=true&w=majority

JWT_SECRET=YOUR_LONG_RANDOM_SECRET
JWT_EXPIRES_IN=1d

FRONTEND_URL=http://localhost:5173
